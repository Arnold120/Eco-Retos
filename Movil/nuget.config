<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- La configuracion global de NuGet tiene packageSourceMapping sin
       Microsoft.Windows.CppWinRT, lo que rompe el build de Windows de los
       plugins de Flutter (permission_handler_windows). Aqui se limpia para
       que el proyecto pueda restaurar paquetes desde nuget.org. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>
</configuration>
